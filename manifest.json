{
  "description": "Adds my own newtab with backgrounds",
  "manifest_version": 2,
  "name": "newTab",
  "version": "1.7.1",
  "icons": {
    "48": "icons/image-48.png"
  },
  "chrome_url_overrides": {
    "newtab": "./index.html"
  },
  "chrome_settings_overrides": {
    "homepage": "./index.html"
  },
  "permissions": ["storage"],
  "browser_specific_settings": {
    "gecko": {
      "id": "newtab-enhanced@lingtiannnnn",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}